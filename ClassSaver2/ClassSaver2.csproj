<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>

        <PackageId>ClassSaver2</PackageId>
        <Version>0.1.0</Version>
        <Authors>nglamdev</Authors>
        <Description>Fast compile-time binary serialization source generator for C#.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/nglammm/ClassSaver2</RepositoryUrl>
        <PackageTags>serialization;source-generator;roslyn;codegen;binary</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Keep runtime output so the consumer gets IDefineDatatype, etc. -->
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <DevelopmentDependency>false</DevelopmentDependency>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackAnalyzerCopy</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />

        <None Include="../README.md" Pack="true" PackagePath="\" Condition="Exists('../README.md')" />
    </ItemGroup>

    <!-- Also copy the DLL to analyzers so Roslyn runs the generator -->
    <Target Name="_PackAnalyzerCopy">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>